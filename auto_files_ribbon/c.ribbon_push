unames = {1:'X', 2:'Y', 3:'Z', 4:'d3x', 5:'d3y', 6:'d3z', 7: 'd2x', 8: 'd2y', 9: 'd2z', 10: 'd1x', 11: 'd1y', 12: 'd1z', 13: 'R1', 14: 'R2', 15: 'R3', 16: 'M1', 17: 'M2', 18: 'M3', 19: 'K2', 20: 'K3', 21: 's'}
parnames = {1: 'Conv', 2:'X', 3:'Y', 4:'Z', 5:'d3x', 6:'d3y', 7:'d3z', 8: 'd2x', 9: 'd2y', 10: 'd2z', 11: 'd1x', 12: 'd1y', 13: 'd1z', 14: 'R1', 15: 'R3_tip', 16: 'R3_base', 17: 'M1', 18: 'M2', 19: 'M3', 20: 'K2', 21: 'K3', 22: 's'}


!! la loi de AUTO : NICP + NDIM = NBC + NINT + 1


NDIM = 21                         !dimension of system
IPS = 4                           !4 corresponds to BVP
IRS = 0                           !where to restart from (default 0)
ILP = 1                           !detection of folds (rec: 0)

ICP = [1, 2, 3, 4, 14, 15, 16]    !list of continuation parameters. Here 1 is the true continuation parameters, the others are just values assign to be displayed

NTST= 400                         !number of mesh intervals (rec: as small as possible to maintain cvgence) 80
NCOL= 4                           !number of Gauss collocation points (reco: 4)
IAD = 3                           !mesh adaptation (strongly recommended: 3)
ISP = 2                           !detect all social solutions (reco: 2)
ISW = 1                           !1: normal, -1: restart from branch point in IRS

IPLT = 0                          !allows redefinition of the principal solution measure, which is printed as the second (real) column in the screen output (0: L2 norm)

NBC = 21                          !number of boundary conditions
NINT = 0                          !number of integral conditions

NMX = 500                         !maximum number of steps to be taken along any family before abort

NPR = 50                          !how often to print (print each NPR step (of length DS) of the continuation parameter) --> each print is a solution save in .s file
MXBF = 1                          !unused if IPS=4
IID = 2                           !verbosity 
        
ITMX = 8                          !maximum number of iterations for special solutions such as bifurcation (reco: 8)
ITNW = 5                          !max numbers of correction steps Newton iterations (reco: 5 to 7)                        
NWTN = 3                          !Jacobian gets frozen after NWTN iterations (reco: 3)
 
JAC= 0                            !no derivatives provided by user (0)

EPSL = 1e-06                      !rel. cv. for equation params in Newton method (recommmended: 10^-6 ... 10^-7)
EPSU = 1e-06                      !rel. cv. for solution cmpts in Newton method (recommmended: 10^-6 ... 10^-7)
EPSS = 1e-4                       !rel. arc length cvg for detection of special solutions (reco: 100..1000 x EPSL)

DS = 1e-5                           !Pseudo-arclength (absolute value) AND direction (sign). Pseudo-arclength stepsize is the distance between the current solution and the next solution on a family                       
DSMIN = 1e-9                     !minimum pseudo-arclength --> need smaller value if abort because of MX (and step < NMX)
DSMAX = 1                         !maximum pseudo-arclength
IADS = 1                          !step size adaptation every IADS steps (0: off)

NPAR = 22                         !max number of parameters
THL =  {}                         !weights for parameters
THU =  {}                         !weights fr solutions

UZSTOP= {1: [-1, 1]}             !Stopping condition on continuation parameters
